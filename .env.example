# ============================================================
# RAG 药品问答系统 - 环境变量配置模板
# 使用方式: 复制此文件为 .env，然后填入真实值
#           cp .env.example .env
# ============================================================

# ===== API Keys =====
# 通义千问 API Key（用于嵌入模型 + 生成模型 + 意图识别模型）
# 申请地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_api_key

# ===== Milvus 向量数据库 =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== MySQL 数据库 =====
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=rag_pharma

# ===== Redis 缓存 & 会话 =====
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=                        # 暂时不设密码，需要时取消注释

# ===== API 鉴权 =====
# 用于外部调用本系统 API 时的密钥。为空时跳过鉴权。
APP_API_KEY=your_api_key_here

# ===== 应用配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
